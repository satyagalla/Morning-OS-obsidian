+  const render = (): void => {
+    const label = undoDescription(app);
+    const running = isUndoRunning(app);
+    const description = label ? `Undo: ${label}` : "Undo unavailable: nothing to undo";
+    button.disabled = !label || running;
+    button.setAttribute("aria-label", running && label ? `Undoing: ${label}` : description);
+    button.setAttribute("title", running && label ? `Undoing: ${label}` : description);
+  };
+  button.addEventListener("click", () => { void plugin.undoLastReversibleChange(); });
+  const unsubscribe = subscribeToUndo(app, render);
+  render();
+  return unsubscribe;
+}
