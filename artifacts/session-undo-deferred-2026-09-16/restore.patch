+/** Shared, session-global Undo control, deliberately separate from search and options. */
+export function mountUndoControl(parent: HTMLElement, app: App, plugin: MorningOSPlugin): () => void {
+  const button = parent.createEl("button", { cls: "mos-undo-button", attr: { type: "button" } });
