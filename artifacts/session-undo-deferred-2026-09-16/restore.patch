index 0000000..cca08aa
--- /dev/null
+++ b/src/undo-manager.ts
@@ -0,0 +1,132 @@
+import type { App } from "obsidian";
+import type { MorningState } from "./data/schemas";
+import { getStateStore } from "./data/state-store";
+import type { Task } from "./types";
+
+interface FieldChange {
+  id: string;
+  field: keyof Task;
+  before: unknown;
+  after: unknown;
+}
+
+interface UndoEntry {
+  label: string;
+  changes: FieldChange[];
+}
+
+export type UndoResult = { ok: true; label: string } | { ok: false; message: string };
+
+const histories = new WeakMap<App, UndoEntry[]>();
+const listeners = new WeakMap<App, Set<() => void>>();
+const runningUndos = new WeakMap<App, Promise<UndoResult>>();
+
+function same(left: unknown, right: unknown): boolean {
+  return JSON.stringify(left) === JSON.stringify(right);
+}
+
+function history(app: App): UndoEntry[] {
+  let entries = histories.get(app);
+  if (!entries) {
+    entries = [];
+    histories.set(app, entries);
+  }
+  return entries;
+}
+
+function notify(app: App): void {
+  for (const listener of listeners.get(app) ?? []) listener();
+}
+
+/** Subscribe mounted controls without making the session history persistent. */
+export function subscribeToUndo(app: App, listener: () => void): () => void {
+  let appListeners = listeners.get(app);
+  if (!appListeners) {
+    appListeners = new Set();
+    listeners.set(app, appListeners);
+  }
+  appListeners.add(listener);
+  return () => appListeners?.delete(listener);
+}
+
+/** Record only changed fields. Undo never reactivates a stale complete registry. */
+export function recordUndo(app: App, label: string, before: MorningState, after: MorningState): void {
+  const beforeItems = new Map(before.items.map(item => [item._id, item]));
+  const afterItems = new Map(after.items.map(item => [item._id, item]));
+  const changes: FieldChange[] = [];
+  for (const [id, next] of afterItems) {
+    const previous = beforeItems.get(id);
+    if (!previous) continue; // Creation is intentionally not yet undoable.
+    for (const field of Object.keys(next) as (keyof Task)[]) {
+      if (field === "date_modified" || same(previous[field], next[field])) continue;
+      changes.push({ id, field, before: clone(previous[field]), after: clone(next[field]) });
+    }
+  }
+  if (!changes.length) return;
+  const entries = history(app);
+  entries.push({ label, changes });
+  // Session-local and bounded; it is neither persisted nor a user-operation log.
+  if (entries.length > 40) entries.shift();
+  notify(app);
+}
+
+export function undoDescription(app: App): string | null {
+  return history(app).at(-1)?.label ?? null;
+}
+
+export function isUndoRunning(app: App): boolean {
+  return runningUndos.has(app);
+}
+
+export async function undoLast(app: App): Promise<UndoResult> {
+  // A command and a button click that overlap refer to one operation, rather
+  // than consuming the first and second entries in rapid succession.
+  const existing = runningUndos.get(app);
+  if (existing) return existing;
+  const request = undoLatest(app);
+  runningUndos.set(app, request);
+  notify(app);
+  try {
+    return await request;
+  } finally {
+    runningUndos.delete(app);
+    notify(app);
+  }
+}
+
+async function undoLatest(app: App): Promise<UndoResult> {
+  const entries = history(app);
+  const entry = entries.at(-1);
+  if (!entry) return { ok: false, message: "Nothing to undo. Permanent purge and external changes are not undoable." };
+  let conflict = false;
+  await getStateStore(app).update(state => {
+    // This must run inside StateStore's serialized mutation. Checking before
+    // entering its queue could otherwise approve stale data and overwrite a
+    // queued local operation.
+    const incompatible = entry.changes.find(change => {
+      const item = state.items.find(candidate => candidate._id === change.id);
+      return !item || !same(item[change.field], change.after);
+    });
+    if (incompatible) {
+      conflict = true;
+      return;
+    }
+    for (const change of entry.changes) {
+      const item = state.items.find(candidate => candidate._id === change.id);
+      if (!item) throw new Error("item changed while applying Undo");
+      item[change.field] = clone(change.before) as never;
+    }
+  }, `undo-${entry.label}`);
+  if (conflict) {
+    return { ok: false, message: `Cannot safely undo ${entry.label}: a later change affects this item.` };
+  }
+  // Do not remove an entry until the verified StateStore commit succeeded.
+  entries.pop();
+  notify(app);
+  return { ok: true, label: entry.label };
+}
+
+function clone<T>(value: T): T {
+  if (value === undefined) return value;
+  return JSON.parse(JSON.stringify(value)) as T;
+}
